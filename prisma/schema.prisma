generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Rol {
  USUARIO
  ADMIN
}

enum EstadoInscripcion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoSolicitud {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum TipoApoyo {
  ALIMENTOS
  SALUD
  EDUCACION
  VIVIENDA
  EMPLEO
  OTRO
}

enum CanalDonacion {
  PASARELA
  TRANSFERENCIA
  EFECTIVO
  LLAVE
}

enum EstadoDonacion {
  PENDIENTE
  COMPLETADA
  FALLIDA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EntidadHistorial {
  DONACION
  INSCRIPCION
  SOLICITUD
}

enum FinalidadConsentimiento {
  REGISTRO
  SOLICITUD_AYUDA
}

// Orden de los campos en todas las tablas:
// llave primaria → llaves foráneas → datos → estado → fechas.
// Las llaves foráneas a una lista maestra (catálogo) van junto al dato que describen.

// ---- Listas maestras: catálogos que el administrador amplía sin tocar código ----

model ListaMaestra {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  creadoEn    DateTime @default(now())

  opciones OpcionListaMaestra[]
}

model OpcionListaMaestra {
  id             Int          @id @default(autoincrement())
  listaMaestraId Int
  listaMaestra   ListaMaestra @relation(fields: [listaMaestraId], references: [id], onDelete: Cascade)
  codigo         String       @db.VarChar(30)
  nombre         String       @db.VarChar(100)
  orden          Int          @default(0)
  activo         Boolean      @default(true)
  creadoEn       DateTime     @default(now())

  usuariosConTipoDocumento    Usuario[]               @relation("TipoDocumentoUsuario")
  solicitudesConTipoDocumento SolicitudBeneficiario[] @relation("TipoDocumentoSolicitud")

  @@unique([listaMaestraId, codigo])
}

// ---- Usuarios ----

model Usuario {
  id              Int                 @id @default(autoincrement())
  rol             Rol
  nombre          String
  telefono        String?
  tipoDocumentoId Int?
  tipoDocumento   OpcionListaMaestra? @relation("TipoDocumentoUsuario", fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  numeroDocumento String?
  ciudad          String?
  email           String              @unique
  passwordHash    String
  creadoEn        DateTime            @default(now())

  donaciones      Donacion[]
  inscripciones   InscripcionVoluntario[]
  solicitudes     SolicitudBeneficiario[]
  cambiosEstado   HistorialEstado[]
  logCambios      LogCambio[]
  consentimientos ConsentimientoDatos[]
}

model ConsentimientoDatos {
  id              Int                     @id @default(autoincrement())
  usuarioId       Int
  usuario         Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  finalidad       FinalidadConsentimiento
  versionPolitica String
  aceptadoEn      DateTime                @default(now())
}

// ---- Programas, jornadas y campañas ----

model Programa {
  id                  Int      @id @default(autoincrement())
  nombre              String
  descripcion         String   @db.Text
  metaCupoVoluntarios Int      @default(0)
  creadoEn            DateTime @default(now())

  campanas      Campana[]
  actividades   Actividad[]
  inscripciones InscripcionVoluntario[]
  solicitudes   SolicitudBeneficiario[]
}

model Actividad {
  id          Int      @id @default(autoincrement())
  programaId  Int
  programa    Programa @relation(fields: [programaId], references: [id])
  titulo      String
  descripcion String   @db.Text
  fecha       DateTime @db.Date
  horaInicio  String
  horaFin     String
  lugar       String
  cupo        Int
  creadoEn    DateTime @default(now())

  inscripciones InscripcionVoluntario[]
}

model Campana {
  id          Int      @id @default(autoincrement())
  programaId  Int
  programa    Programa @relation(fields: [programaId], references: [id])
  titulo      String
  descripcion String   @db.Text
  metaMonto   Decimal  @db.Decimal(12, 2)
  creadoEn    DateTime @default(now())

  donaciones Donacion[]
  novedades  NovedadCampana[]
}

// Actualizaciones de impacto que el equipo publica sobre una campaña; las ven quienes donaron a ella.
model NovedadCampana {
  id        Int      @id @default(autoincrement())
  campanaId Int
  campana   Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  titulo    String   @db.VarChar(150)
  contenido String   @db.Text
  creadoEn  DateTime @default(now())

  @@index([campanaId, creadoEn])
}

// ---- Donaciones y pagos ----

model Donacion {
  id        Int            @id @default(autoincrement())
  campanaId Int
  campana   Campana        @relation(fields: [campanaId], references: [id])
  donanteId Int?
  donante   Usuario?       @relation(fields: [donanteId], references: [id])
  monto     Decimal        @db.Decimal(12, 2)
  canal     CanalDonacion
  estado    EstadoDonacion @default(PENDIENTE)
  creadoEn  DateTime       @default(now())

  pago Pago?
}

model Pago {
  id                Int           @id @default(autoincrement())
  donacionId        Int           @unique
  donacion          Donacion      @relation(fields: [donacionId], references: [id], onDelete: Cascade)
  referencia        String        @unique
  metodo            CanalDonacion
  estado            EstadoPago
  respuestaPasarela String?       @db.Text
  creadoEn          DateTime      @default(now())
}

// Datos que ve el donante para pagar por transferencia, llave Bre-B o en efectivo (una sola fila, id = 1).
model DatosPago {
  id                Int      @id @default(1)
  banco             String   @db.VarChar(100)
  tipoCuenta        String   @db.VarChar(40)
  numeroCuenta      String   @db.VarChar(40)
  titular           String   @db.VarChar(150)
  nit               String   @db.VarChar(30)
  llave             String   @db.VarChar(100)
  direccionEfectivo String   @db.VarChar(255)
  horarioEfectivo   String   @db.VarChar(150)
  actualizadoEn     DateTime @updatedAt
}

// ---- Voluntariado y solicitudes de ayuda ----

model InscripcionVoluntario {
  id           Int               @id @default(autoincrement())
  voluntarioId Int
  voluntario   Usuario           @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  programaId   Int
  programa     Programa          @relation(fields: [programaId], references: [id])
  actividadId  Int?
  actividad    Actividad?        @relation(fields: [actividadId], references: [id])
  estado       EstadoInscripcion @default(PENDIENTE)
  creadoEn     DateTime          @default(now())

  @@unique([voluntarioId, actividadId])
}

model SolicitudBeneficiario {
  id                     Int                @id @default(autoincrement())
  beneficiarioId         Int
  beneficiario           Usuario            @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  programaId             Int
  programa               Programa           @relation(fields: [programaId], references: [id])
  tipoApoyo              TipoApoyo          @default(OTRO)
  descripcion            String             @db.Text
  nombreCompleto         String
  tipoDocumentoId        Int
  tipoDocumento          OpcionListaMaestra @relation("TipoDocumentoSolicitud", fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  numeroDocumento        String
  telefono               String
  direccion              String
  ciudad                 String
  personasACargo         Int                @default(1)
  aceptaTratamientoDatos Boolean            @default(false)
  estado                 EstadoSolicitud    @default(PENDIENTE)
  creadoEn               DateTime           @default(now())
}

// ---- Trazabilidad ----

model HistorialEstado {
  id             Int              @id @default(autoincrement())
  usuarioId      Int?
  usuario        Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  entidad        EntidadHistorial
  entidadId      Int
  estadoAnterior String?
  estadoNuevo    String
  nota           String?
  creadoEn       DateTime         @default(now())

  @@index([entidad, entidadId])
}

model LogCambio {
  id              Int      @id @default(autoincrement())
  usuarioId       Int?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  modulo          String   @db.VarChar(30)
  accion          String   @db.VarChar(40)
  descripcion     String   @db.Text
  // A quién o a qué se le hizo el cambio: tipo ("Usuario", "Programa"…) y nombre.
  afectadoTipo    String?  @db.VarChar(40)
  afectadoNombre  String?  @db.VarChar(255)
  // JSON con los campos que cambiaron: { "Campo": "valor" }.
  datosAnteriores String?  @db.Text
  datosNuevos     String?  @db.Text
  ip              String?  @db.VarChar(64)
  creadoEn        DateTime @default(now())

  @@index([creadoEn])
  @@index([modulo])
}
