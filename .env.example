# Cadena de conexión a MySQL/MariaDB. Formato: mysql://usuario:password@host:puerto/base_de_datos
DATABASE_URL="mysql://root:password@localhost:3306/redminuto"

# Puerto donde escucha la API
PORT=4000

# Origen permitido para peticiones CORS (la URL donde corre redminuto-web)
CORS_ORIGIN="http://localhost:5173"

# Secreto para firmar los tokens JWT — cambia este valor en producción
JWT_SECRET="cambia-este-valor-en-produccion"

# Credenciales del usuario administrador que crea `npm run seed:admin` (opcionales, tienen valores por defecto)
ADMIN_EMAIL="admin@casaminutodedios.org"
ADMIN_PASSWORD="CambiarClave123"
